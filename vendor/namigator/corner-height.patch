+const float* VertexAt(const dtNavMesh& mesh, dtPolyRef ref, const float* pos)
+{
+    const dtMeshTile* tile = nullptr;
+    const dtPoly* poly = nullptr;
+    if (dtStatusFailed(mesh.getTileAndPolyByRef(ref, &tile, &poly)) ||
+        poly->getType() == DT_POLYTYPE_OFFMESH_CONNECTION)
+        return nullptr;
+
+    for (int i = 0; i < poly->vertCount; ++i)
+    {
+        const float* v = &tile->verts[poly->verts[i] * 3];
+        if (v[0] == pos[0] && v[2] == pos[2])
+            return v;
+    }
+
+    return nullptr;
+}
+
+// findNearestPoly() picks one of the polygons that share a vertex.  When the
+// source is exactly that vertex and the ray leaves the chosen polygon at the
+// source (t == 0), restart it from each other polygon sharing the vertex and
+// keep the first ray that reaches the target.
+void RaycastFromSharedVertex(const dtNavMesh& mesh,
+                             const dtNavMeshQuery& query,
+                             const dtQueryFilter& filter, dtPolyRef startRef,
+                             const float* source, const float* target,
+                             const float* extents, dtRaycastHit& hit)
+{
+    const float* vertex = VertexAt(mesh, startRef, source);
+    if (!vertex)
+        return;
+
+    dtPolyRef polys[32];
+    int polyCount = 0;
+    if (dtStatusFailed(query.queryPolygons(source, extents, &filter, polys,
+                                           &polyCount, 32)))
+        return;
+
+    for (int i = 0; i < polyCount; ++i)
+    {
+        if (polys[i] == startRef)
+            continue;
+
+        const float* other = VertexAt(mesh, polys[i], source);
+        if (!other || other[1] != vertex[1])
+            continue;
+
+        dtPolyRef path[100];
+        dtRaycastHit retry;
+        retry.path = path;
+        retry.maxPath = std::min(hit.maxPath, 100);
+        if (query.raycast(polys[i], source, target, &filter, 0, &retry) !=
+                DT_SUCCESS ||
+            retry.t != std::numeric_limits<float>::max())
+            continue;
+
+        std::copy(path, path + retry.pathCount, hit.path);
+        hit.pathCount = retry.pathCount;
+        hit.t = retry.t;
+        hit.hitEdgeIndex = retry.hitEdgeIndex;
+        dtVcopy(hit.hitNormal, retry.hitNormal);
+        return;
+    }
+}
+
 } // anonymous namespace
 

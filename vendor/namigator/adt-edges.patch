+// the interpolation of dtClosestHeightPointTriangle(), without its test that
+// the point lies inside the triangle
+float PlaneHeight(const float* p, const float* a, const float* b,
+                  const float* c)
+{
+    float v0[3], v1[3], v2[3];
+    dtVsub(v0, c, a);
+    dtVsub(v1, b, a);
+    dtVsub(v2, p, a);
+    auto denom = v0[0] * v1[2] - v0[2] * v1[0];
+    auto u = v1[2] * v2[0] - v1[0] * v2[2];
+    auto v = v0[0] * v2[2] - v0[2] * v2[0];
+    if (denom < 0)
+    {
+        denom = -denom;
+        u = -u;
+        v = -v;
+    }
+    return a[1] + (v0[1] * u + v1[1] * v) / denom;
+}

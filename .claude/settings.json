{
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "fp=$(jq -r '.tool_input.file_path // empty'); case \"$fp\" in src/*.ts|*/src/*.ts) [ -f \"$fp\" ] || exit 0; mise exec -- biome format --write \"$fp\";; esac"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "fp=$(jq -r '.tool_input.file_path // empty'); case \"$fp\" in src/*.ts|*/src/*.ts) tf=\"${fp%.ts}\"; tf=\"${tf%.test}.test.ts\"; [ -f \"$tf\" ] || exit 0; mise test \"$tf\" --bail;; esac"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(./dist/tuicraft:*)",
      "Bash(gh issue list:*)",
      "Bash(gh release list:*)",
      "Bash(gh release view:*)",
      "Bash(gh repo view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh search:*)",
      "Bash(git add:*)",
      "Bash(git check-ignore:*)",
      "Bash(git checkout:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(git stash:*)",
      "Bash(mise build:*)",
      "Bash(mise ci:*)",
      "Bash(mise format:*)",
      "Bash(mise start:*)",
      "Bash(mise tasks:*)",
      "Bash(mise test:*)",
      "Bash(mise typecheck:*)",
      "Skill(claude-md-management:revise-claude-md)",
      "WebFetch(domain:bun.com)",
      "WebFetch(domain:mise.jdx.dev)",
      "WebFetch(domain:tuicraft.vararu.org)",
      "WebFetch(domain:wowdev.wiki)",
      "WebSearch"
    ],
    "deny": [
      "Bash(env :*)",
      "Bash(env)",
      "Bash(export :*)",
      "Bash(export)",
      "Bash(mise env :*)",
      "Bash(mise env)",
      "Bash(printenv:*)",
      "Bash(set)"
    ]
  }
}

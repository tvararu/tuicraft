#!/usr/bin/env bash
set -euo pipefail

self=$(readlink -f "${BASH_SOURCE[0]}")

real_omp() {
  local IFS=:
  local dir candidate
  for dir in $PATH; do
    candidate="${dir:-.}/omp"
    [[ -x $candidate && ! -d $candidate ]] || continue
    [[ $(readlink -f "$candidate") == "$self" ]] && continue
    printf '%s\n' "$candidate"
    return 0
  done
  printf 'omp-factory: no omp on PATH besides this wrapper\n' >&2
  return 127
}

mirror() {
  local real=$1 dir=$2 entry name
  mkdir -p "$dir"
  chmod 700 "$dir"
  [[ -n $real && -d $real && $real != "$dir" ]] || return 0
  for entry in "$real"/* "$real"/.[!.]* "$real"/..?*; do
    [[ -e $entry || -L $entry ]] || continue
    name=${entry##*/}
    [[ $name == tuicraft || $name == tuicraft-factory-* ]] && continue
    [[ -e $dir/$name || -L $dir/$name ]] && continue
    ln -sfn -- "$entry" "$dir/$name"
  done
}

prune() {
  local dir
  for dir in "$1"/tuicraft-factory-*/; do
    [[ -L ${dir}.factory-gitdir && ! -e ${dir}.factory-gitdir ]] || continue
    rm -rf -- "$dir" || true
  done
}

isolate() {
  local git_dir=$1 base=$1/factory-xdg real=${XDG_RUNTIME_DIR:-} hash runtime
  if [[ -L $real/.factory-gitdir ]]; then
    real=${real%/*}
  fi
  hash=$(printf '%s' "$git_dir" | sha256sum)
  runtime=${real:-${TMPDIR:-/tmp}}/tuicraft-factory-${hash:0:12}
  prune "${runtime%/*}"
  mirror "${XDG_CONFIG_HOME:-$HOME/.config}" "$base/config"
  mirror "$real" "$runtime"
  mirror "${XDG_STATE_HOME:-$HOME/.local/state}" "$base/state"
  ln -sfn -- "$git_dir" "$runtime/.factory-gitdir"
  export XDG_CONFIG_HOME=$base/config
  export XDG_RUNTIME_DIR=$runtime
  export XDG_STATE_HOME=$base/state
}

tuicraft_worktree() {
  local main common top
  main=$(readlink -f "$HOME/code/tuicraft")
  common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) ||
    return 1
  top=$(git rev-parse --show-toplevel 2>/dev/null) || return 1
  [[ $common == "$main/.git" && $top != "$main" ]] || return 1
  git rev-parse --absolute-git-dir
}

role=""
for arg in "$@"; do
  if [[ $arg =~ ^\[factory:(worker|reviewer|merger|qa)\] ]]; then
    role=${BASH_REMATCH[1]}
    break
  fi
done

omp=$(real_omp)

if git_dir=$(tuicraft_worktree); then
  isolate "$git_dir"
elif [[ -n $role ]]; then
  isolate "$(git rev-parse --absolute-git-dir 2>/dev/null || printf '%s/tmp' "$PWD")"
fi

if [[ -z $role ]]; then
  exec "$omp" "$@"
fi

case $role in
  worker) cap=3h ;;
  qa) cap=2h ;;
  *) cap=1h ;;
esac

roles_env="${HOME}/.config/tuicraft-factory/roles.env"
if [[ -f $roles_env ]]; then
  source "$roles_env"
fi

prefix=${role^^}
model_var="${prefix}_MODEL"
thinking_var="${prefix}_THINKING"
flags=(--max-time "$cap")
flags+=(--config "$(dirname "$self")/omp-factory.yml")
if [[ -n ${!model_var:-} ]]; then
  flags+=(--model "${!model_var}")
fi
if [[ -n ${!thinking_var:-} ]]; then
  flags+=(--thinking "${!thinking_var}")
fi

exec "$omp" "${flags[@]}" "$@"

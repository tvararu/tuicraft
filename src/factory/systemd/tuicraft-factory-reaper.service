[Unit]
Description=tuicraft factory worktree reaper

[Service]
Type=oneshot
WorkingDirectory=%h
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=RUNNER=%h/.local/share/tuicraft-factory/runner
ExecStartPre=/bin/sh -c 'test -d "$RUNNER/.git" || git clone -q https://github.com/tvararu/tuicraft.git "$RUNNER"'
ExecStartPre=-/bin/sh -c 'git -C "$RUNNER" fetch -q origin main && git -C "$RUNNER" reset -q --hard origin/main'
ExecStart=%h/.local/share/mise/shims/bun ${RUNNER}/src/factory/main.ts reap

{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "assist": {
    "actions": {
      "source": {
        "noDuplicateClasses": "on",
        "organizeImports": "on",
        "useSortedAttributes": "on",
        "useSortedInterfaceMembers": "on",
        "useSortedKeys": "on",
        "useSortedProperties": "on"
      }
    }
  },
  "files": {
    "includes": ["packages/**"]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "javascript": {
    "globals": ["Bun"]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "complexity": {
        "noExcessiveCognitiveComplexity": "error",
        "noExcessiveLinesPerFunction": "error",
        "noExcessiveNestedTestSuites": "error",
        "noForEach": "error",
        "noImplicitCoercions": "error",
        "noUselessCatchBinding": "error",
        "noUselessReturn": "error",
        "noUselessStringConcat": "error",
        "noUselessUndefined": "error",
        "useLiteralKeys": "off",
        "useMaxParams": "error",
        "useSimplifiedLogicExpression": "error",
        "useWhile": "error"
      },
      "correctness": {
        "noGlobalDirnameFilename": "error",
        "noUndeclaredVariables": "error"
      },
      "performance": {
        "noBarrelFile": "error",
        "noReExportAll": "error",
        "useTopLevelRegex": "error"
      },
      "security": {
        "noSecrets": "error"
      },
      "style": {
        "noDefaultExport": "error",
        "noDoneCallback": "error",
        "noEnum": "error",
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": {
            "maxLines": 500,
            "skipBlankLines": true
          }
        },
        "noExportedImports": "error",
        "noInferrableTypes": "error",
        "noNamespace": "error",
        "noNegationElse": "error",
        "noNestedTernary": "error",
        "noParameterAssign": "error",
        "noParameterProperties": "error",
        "noProcessEnv": "error",
        "noShoutyConstants": "error",
        "noSubstr": "error",
        "noUnusedTemplateLiteral": "error",
        "noUselessElse": "error",
        "noYodaExpression": "error",
        "useAsConstAssertion": "error",
        "useAtIndex": "error",
        "useCollapsedElseIf": "error",
        "useCollapsedIf": "error",
        "useConsistentArrayType": "error",
        "useConsistentArrowReturn": "error",
        "useConsistentBuiltinInstantiation": "error",
        "useConsistentMemberAccessibility": "error",
        "useConsistentMethodSignatures": {
          "level": "error",
          "options": {
            "style": "property"
          }
        },
        "useConsistentObjectDefinitions": {
          "level": "error",
          "options": {
            "syntax": "shorthand"
          }
        },
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "type"
          }
        },
        "useDefaultParameterLast": "error",
        "useDefaultSwitchClause": "error",
        "useErrorCause": "error",
        "useExplicitLengthCheck": "error",
        "useFilenamingConvention": "error",
        "useForOf": "error",
        "useGroupedAccessorPairs": "error",
        "useNumberNamespace": "error",
        "useNumericSeparators": "error",
        "useObjectSpread": "error",
        "useReadonlyClassProperties": "error",
        "useShorthandAssign": "error",
        "useSymbolDescription": "error",
        "useThrowNewError": "error",
        "useThrowOnlyError": "error",
        "useTrimStartEnd": "error",
        "useUnifiedTypeSignatures": "error"
      },
      "suspicious": {
        "noAlert": "error",
        "noBitwiseOperators": "error",
        "noConstantBinaryExpressions": "error",
        "noDeprecatedImports": "error",
        "noEmptyBlockStatements": "error",
        "noEqualsToNull": "error",
        "noEvolvingTypes": "error",
        "noImportCycles": "error",
        "noMisplacedAssertion": "error",
        "noShadow": "error",
        "noSkippedTests": "error",
        "noUnassignedVariables": "error",
        "noUnusedExpressions": "error",
        "noVar": "error",
        "useAwait": "error",
        "useDeprecatedDate": "error",
        "useErrorMessage": "error",
        "useGuardForIn": "error",
        "useNumberToFixedDigitsArgument": "error",
        "useStaticResponseMethods": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/factory/src/config.ts"],
      "linter": {
        "rules": {
          "security": {
            "noSecrets": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/**/*.test.ts", "packages/*/test-support/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveLinesPerFunction": "off"
          },
          "performance": {
            "useTopLevelRegex": "off"
          },
          "security": {
            "noSecrets": "off"
          },
          "style": {
            "noProcessEnv": "off"
          },
          "suspicious": {
            "noEmptyBlockStatements": "off",
            "useAwait": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/core/src/wow/**", "packages/*/test-support/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noBitwiseOperators": "off"
          }
        }
      }
    },
    {
      "assist": {
        "actions": {
          "source": {
            "useSortedKeys": "off"
          }
        }
      },
      "includes": [
        "packages/core/src/wow/**",
        "packages/cli/src/ui/party-store.test.ts",
        "packages/cli/src/ui/control-replan.test.ts"
      ]
    },
    {
      "includes": ["packages/core/src/wow/protocol/opcodes.ts"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": "off",
            "useNumericSeparators": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/core/src/wow/index.ts",
        "packages/core/src/wow/session.ts",
        "packages/core/test-support/internals.ts"
      ],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@tuicraft/**"],
                    "message": "Core imports nothing from other packages; inside core use \"#wow/…\", \"#lib/…\" or \"#test-support/…\"."
                  },
                  {
                    "group": ["@earendil-works/**", "../**/@earendil-works/**"],
                    "message": "Only packages/harness may import the Pi SDK (@earendil-works/*)."
                  },
                  {
                    "group": [
                      "../**/core/src/**",
                      "../**/core/test-support/**",
                      "../**/cli/src/**",
                      "../**/cli/test-support/**",
                      "../**/factory/src/**",
                      "../**/factory/test-support/**",
                      "../**/devtools/src/**",
                      "../**/harness/src/**",
                      "../**/packages/**",
                      "../**/node_modules/**"
                    ],
                    "message": "Import another package by its name, never by a relative path into its directory."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/core/src/**", "!packages/core/src/**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@tuicraft/**"],
                    "message": "Core imports nothing from other packages; inside core use \"#wow/…\" or \"#lib/…\"."
                  },
                  {
                    "group": ["#test-support/**", "../**/test-support/**"],
                    "message": "Core runtime code must not import test support."
                  },
                  {
                    "group": ["@earendil-works/**", "../**/@earendil-works/**"],
                    "message": "Only packages/harness may import the Pi SDK (@earendil-works/*)."
                  },
                  {
                    "group": [
                      "../**/core/src/**",
                      "../**/core/test-support/**",
                      "../**/cli/src/**",
                      "../**/cli/test-support/**",
                      "../**/factory/src/**",
                      "../**/factory/test-support/**",
                      "../**/devtools/src/**",
                      "../**/harness/src/**",
                      "../**/packages/**",
                      "../**/node_modules/**"
                    ],
                    "message": "Import another package by its name, never by a relative path into its directory."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/cli/**",
        "packages/factory/**",
        "packages/devtools/**",
        "packages/harness/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@tuicraft/**",
                      "!@tuicraft/core",
                      "!@tuicraft/core/session",
                      "!@tuicraft/core/lib/*",
                      "!@tuicraft/core/test-support/*"
                    ],
                    "message": "Shells import core only from \"@tuicraft/core\" (the barrel), \"@tuicraft/core/session\", \"@tuicraft/core/lib/<module>\" and, in tests, \"@tuicraft/core/test-support/<module>\"."
                  },
                  {
                    "group": ["@earendil-works/**", "../**/@earendil-works/**"],
                    "message": "Only packages/harness may import the Pi SDK (@earendil-works/*)."
                  },
                  {
                    "group": [
                      "../**/core/src/**",
                      "../**/core/test-support/**",
                      "../**/cli/src/**",
                      "../**/cli/test-support/**",
                      "../**/factory/src/**",
                      "../**/factory/test-support/**",
                      "../**/devtools/src/**",
                      "../**/harness/src/**",
                      "../**/packages/**",
                      "../**/node_modules/**"
                    ],
                    "message": "Import another package by its name, never by a relative path into its directory."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/cli/src/**",
        "packages/factory/src/**",
        "packages/devtools/src/**",
        "packages/harness/src/**",
        "!**/*.test.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@tuicraft/**",
                      "!@tuicraft/core",
                      "!@tuicraft/core/session",
                      "!@tuicraft/core/lib/*"
                    ],
                    "message": "Shells import core only from \"@tuicraft/core\" (the barrel), \"@tuicraft/core/session\", \"@tuicraft/core/lib/<module>\" and, in tests, \"@tuicraft/core/test-support/<module>\"."
                  },
                  {
                    "group": ["@earendil-works/**", "../**/@earendil-works/**"],
                    "message": "Only packages/harness may import the Pi SDK (@earendil-works/*)."
                  },
                  {
                    "group": [
                      "../**/core/src/**",
                      "../**/core/test-support/**",
                      "../**/cli/src/**",
                      "../**/cli/test-support/**",
                      "../**/factory/src/**",
                      "../**/factory/test-support/**",
                      "../**/devtools/src/**",
                      "../**/harness/src/**",
                      "../**/packages/**",
                      "../**/node_modules/**"
                    ],
                    "message": "Import another package by its name, never by a relative path into its directory."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/harness/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@tuicraft/**",
                      "!@tuicraft/core",
                      "!@tuicraft/core/session",
                      "!@tuicraft/core/lib/*",
                      "!@tuicraft/core/test-support/*"
                    ],
                    "message": "Shells import core only from \"@tuicraft/core\" (the barrel), \"@tuicraft/core/session\", \"@tuicraft/core/lib/<module>\" and, in tests, \"@tuicraft/core/test-support/<module>\"."
                  },
                  {
                    "group": [
                      "../**/core/src/**",
                      "../**/core/test-support/**",
                      "../**/cli/src/**",
                      "../**/cli/test-support/**",
                      "../**/factory/src/**",
                      "../**/factory/test-support/**",
                      "../**/devtools/src/**",
                      "../**/harness/src/**",
                      "../**/packages/**",
                      "../**/node_modules/**"
                    ],
                    "message": "Import another package by its name, never by a relative path into its directory."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/harness/src/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@tuicraft/**",
                      "!@tuicraft/core",
                      "!@tuicraft/core/session",
                      "!@tuicraft/core/lib/*"
                    ],
                    "message": "Shells import core only from \"@tuicraft/core\" (the barrel), \"@tuicraft/core/session\", \"@tuicraft/core/lib/<module>\" and, in tests, \"@tuicraft/core/test-support/<module>\"."
                  },
                  {
                    "group": [
                      "../**/core/src/**",
                      "../**/core/test-support/**",
                      "../**/cli/src/**",
                      "../**/cli/test-support/**",
                      "../**/factory/src/**",
                      "../**/factory/test-support/**",
                      "../**/devtools/src/**",
                      "../**/harness/src/**",
                      "../**/packages/**",
                      "../**/node_modules/**"
                    ],
                    "message": "Import another package by its name, never by a relative path into its directory."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "plugins": ["./config/biome.grit"],
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  }
}
